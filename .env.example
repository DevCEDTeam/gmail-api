# ============================================================================
# Gmail Bulk Sending — Environment Variables
# Project: gmail-bulk-sending (gmail-bulk-sending-389112)
# ============================================================================

# ---------------------------------------------------------------------------
# GCP Project
# ---------------------------------------------------------------------------
GCP_PROJECT_ID=gmail-bulk-sending-389112
USE_SECRET_MANAGER=false

# ---------------------------------------------------------------------------
# OAuth2 Credentials — Wristband 1: General (gmail-bulk-sending-1)
# ---------------------------------------------------------------------------
GENERAL_CLIENT_ID=your_general_client_id
GENERAL_CLIENT_SECRET=your_general_client_secret
GENERAL_REFRESH_TOKEN=your_general_refresh_token
GENERAL_SENDER_EMAIL=noreply@cfored.com
GENERAL_SENDER_NAME=cfored.com

# ---------------------------------------------------------------------------
# OAuth2 Credentials — Wristband 2: Director (gmail-bulk-sending-2)
# ---------------------------------------------------------------------------
DIRECTOR_CLIENT_ID=your_director_client_id
DIRECTOR_CLIENT_SECRET=your_director_client_secret
DIRECTOR_REFRESH_TOKEN=your_director_refresh_token
DIRECTOR_SENDER_EMAIL=director@cfored.com
DIRECTOR_SENDER_NAME=Director

# ---------------------------------------------------------------------------
# OAuth2 Credentials — Wristband 3: Team (gmail-bulk-sending-3)
# ---------------------------------------------------------------------------
TEAM_CLIENT_ID=your_team_client_id
TEAM_CLIENT_SECRET=your_team_client_secret
TEAM_REFRESH_TOKEN=your_team_refresh_token
TEAM_SENDER_EMAIL=team@cfored.com
TEAM_SENDER_NAME=Team cfored

# ---------------------------------------------------------------------------
# OAuth2 Redirect URI (shared by all profiles)
# ---------------------------------------------------------------------------
REDIRECT_URI=https://developers.google.com/oauthplayground

# ---------------------------------------------------------------------------
# Firebase Realtime Database
# ---------------------------------------------------------------------------
FIREBASE_DATABASE_URL=https://gmail-bulk-sending-389112-default-rtdb.firebaseio.com
# For local dev, set path to service account key JSON:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ---------------------------------------------------------------------------
# Mautic / Tracking
# ---------------------------------------------------------------------------
MAUTIC_BASE_URL=https://mautic.cfored.com
TRACKING_BASE_URL=https://mautic.cfored.com
DOMAIN=cfored.com

# ---------------------------------------------------------------------------
# DuoCircle SMTP Relay (Alternative Transport)
# Set EMAIL_TRANSPORT=duocircle to route all email through DuoCircle
# Set EMAIL_TRANSPORT=gmail (default) to use Gmail OAuth2
# ---------------------------------------------------------------------------
EMAIL_TRANSPORT=gmail
DUOCIRCLE_HOST=smtp.duocircle.com
DUOCIRCLE_PORT=587
DUOCIRCLE_USER=your-duocircle-username
DUOCIRCLE_PASS=your-duocircle-password
DUOCIRCLE_SECURE=false

# ---------------------------------------------------------------------------
# Server Ports
# ---------------------------------------------------------------------------
RELAY_PORT=3000
WEBHOOK_PORT=3001

# ---------------------------------------------------------------------------
# Queue Worker
# ---------------------------------------------------------------------------
QUEUE_CONCURRENCY=5

# ---------------------------------------------------------------------------
# Weekly Report
# ---------------------------------------------------------------------------
REPORT_RECIPIENT=director@cfored.com
